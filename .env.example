# SAMA frontend environment
# Setup: cp .env.example .env.local, then fill values. Never commit .env.local.
# Only NEXT_PUBLIC_* values belong here: they are compiled into the browser bundle. API keys live in sama-backend/.env.

# mock: screens use demo data in the browser (no backend); sign-in is still real Privy and nothing is signed or sent.
# live: calls sama-backend (Elysia, default http://localhost:3300) and signs with the user's Privy wallet.
NEXT_PUBLIC_SAMA_API_MODE=mock

# Base URL of sama-backend, e.g. http://localhost:3300. Leave empty when the API is served from the same origin.
NEXT_PUBLIC_SAMA_API_URL=

# 56 = BNB Smart Chain mainnet (SamaSettlement 0x7811a30D29d6c2Ca95Aeb4EE9D896cE44Cb72AC8), 97 = testnet.
# Must match the backend's SAMA_CHAIN_ID in live mode.
NEXT_PUBLIC_SAMA_CHAIN_ID=56

# Privy dashboard (dashboard.privy.io) -> your app -> Settings -> Basics: App ID. Required for sign-in.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: Privy app client ID (Settings -> Clients), for per-environment settings.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Hostnames, for serving one build from several domains (see lib/site.ts and proxy.ts). Leave all three empty for local
# dev and for Vercel Preview: every link stays relative and the proxy does nothing. Set them for Production only.
# Landing, /proof and /demo.
NEXT_PUBLIC_SITE_URL=
# Sign-in and the app. Falls back to NEXT_PUBLIC_SITE_URL while both are served from one host.
NEXT_PUBLIC_APP_URL=
# The guide, served from the root of this host. Set SITE_URL (and APP_URL) too: links leaving the docs must be absolute.
NEXT_PUBLIC_DOCS_URL=
